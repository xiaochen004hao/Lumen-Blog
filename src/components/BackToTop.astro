---
import Icon from './Icon.astro';
---

<button class="back-to-top btn-icon" type="button" data-back-to-top aria-label="返回顶部" title="返回顶部">
  <Icon name="top" size={17} />
</button>

<style>
  .back-to-top {
    position: fixed;
    right: clamp(1rem, 3vw, 2.5rem);
    bottom: clamp(1rem, 3vw, 2.5rem);
    z-index: 900;
    width: 2.9rem;
    height: 2.9rem;
    border-color: transparent;
    background: conic-gradient(var(--ember) var(--scroll-ring, 0%), var(--line) 0);
    backdrop-filter: blur(14px);
    opacity: 0;
    transform: translateY(16px) scale(0.9);
    pointer-events: none;
    transition: opacity var(--t-base) var(--ease-out), transform var(--t-base) var(--ease-spring);
  }
  .back-to-top::before {
    content: '';
    position: absolute;
    inset: 3px;
    border-radius: 50%;
    background: var(--surface);
  }
  .back-to-top :global(svg) {
    position: relative;
    z-index: 1;
  }
  .back-to-top.is-visible {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .back-to-top:hover {
    color: var(--ember);
  }
</style>
