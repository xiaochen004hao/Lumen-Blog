---
import Icon from './Icon.astro';
---

<button class="back-to-top" type="button" data-back-to-top aria-label="返回顶部" title="返回顶部">
  <svg class="scroll-ring" viewBox="0 0 48 48" aria-hidden="true">
    <circle class="ring-track" cx="24" cy="24" r="20" />
    <circle class="ring-progress" cx="24" cy="24" r="20" pathLength="100" />
  </svg>
  <Icon name="top" size={17} />
</button>

<style>
  .back-to-top {
    position: fixed;
    right: clamp(1rem, 3vw, 2.5rem);
    bottom: clamp(1rem, 3vw, 2.5rem);
    z-index: 900;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    backdrop-filter: blur(14px);
    color: var(--ink);
    opacity: 0;
    transform: translateY(16px) scale(0.9);
    pointer-events: none;
    transition: opacity var(--t-base) var(--ease-out), transform var(--t-base) var(--ease-spring), color var(--t-fast);
  }
  .scroll-ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    transform: rotate(-90deg);
  }
  .scroll-ring circle {
    fill: none;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .ring-track { stroke: var(--line-strong); }
  .ring-progress {
    stroke: var(--ember);
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: calc(100 - var(--scroll-progress, 0));
    transition: stroke-dashoffset 120ms linear;
  }
  .back-to-top :global(svg:not(.scroll-ring)) {
    position: relative;
    z-index: 1;
  }
  .back-to-top.is-visible {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .back-to-top:hover {
    color: var(--ember);
  }
</style>
