---
import Icon from './Icon.astro';
---

<div class="search-overlay" data-search-overlay data-pagefind-ignore hidden>
  <div class="search-backdrop" data-search-close></div>
  <div class="search-panel" role="dialog" aria-modal="true" aria-label="站内搜索">
    <div class="search-input-wrap">
      <Icon name="search" size={19} />
      <input
        type="search"
        data-search-input
        placeholder="搜索文章、笔记、标签…"
        autocomplete="off"
        spellcheck="false"
        aria-label="搜索关键词"
      />
      <kbd>ESC</kbd>
    </div>
    <div class="search-results" data-search-results>
      <div class="search-hint">
        <Icon name="sparkles" size={18} />
        <div>
          <strong>开始探索这座花园</strong>
          <span>输入关键词，或试试「设计」「Astro」「思考」</span>
        </div>
      </div>
    </div>
    <div class="search-foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> 选择</span>
      <span><kbd>↵</kbd> 打开</span>
      <span><kbd>esc</kbd> 关闭</span>
      <span class="search-count" data-search-count></span>
    </div>
  </div>
</div>

<style>
  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: min(13vh, 8rem) 1.25rem 2rem;
  }
  .search-overlay[hidden] {
    display: none;
  }
  .search-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(18, 18, 20, 0.44);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    animation: fade-in 240ms var(--ease-out);
  }
  .search-panel {
    position: relative;
    width: min(100%, 660px);
    max-height: min(70vh, 640px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-lg);
    animation: panel-in 460ms var(--ease-spring);
    transform-origin: 50% 0;
  }
  @keyframes fade-in {
    from { opacity: 0; }
  }
  /* Panel enters with a gentle 3D swing instead of a flat slide */
  @keyframes panel-in {
    from {
      opacity: 0;
      transform: perspective(1200px) translateY(-22px) rotateX(5deg) scale(0.985);
    }
  }

  .search-input-wrap {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1.1rem 1.4rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }
  .search-input-wrap input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--ink);
    font-size: 1rem;
  }
  .search-input-wrap input::placeholder {
    color: var(--faint);
  }
  kbd {
    padding: 0.18rem 0.42rem;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: var(--paper-deep);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--muted);
  }

  .search-results {
    flex: 1;
    overflow-y: auto;
    padding: 0.7rem;
    min-height: 180px;
  }
  .search-hint {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem 1rem;
    color: var(--ember);
  }
  .search-hint div {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .search-hint strong {
    color: var(--ink);
    font-size: 0.95rem;
  }
  .search-hint span {
    color: var(--muted);
    font-size: 0.82rem;
  }
  .search-empty {
    display: grid;
    place-items: center;
    gap: 0.5rem;
    padding: 2.5rem 1rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.9rem;
  }

  :global(.search-item) {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    width: 100%;
    padding: 0.85rem 1rem;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    text-align: left;
    transition: background var(--t-fast), transform 280ms var(--ease-spring);
    /* Lively staggered entrance: each result springs in with an overshoot.
       `backwards` holds the hidden start-frame during the stagger delay, and
       releases the element to normal styles once the animation finishes. */
    animation: item-spring-in 520ms var(--ease-bounce) backwards;
    animation-delay: min(calc(var(--i, 0) * 55ms), 380ms);
  }
  @keyframes item-spring-in {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  :global(.search-item.is-selected) {
    transform: translateX(5px);
  }
  :global(.search-hint),
  :global(.search-empty) {
    animation: item-spring-in 560ms var(--ease-bounce) backwards;
  }
  :global(.search-item-icon) {
    display: grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-xs);
    background: var(--ember-soft);
    color: var(--ember);
    transition: transform 300ms var(--ease-bounce), background var(--t-fast), color var(--t-fast);
  }
  :global(.search-item:hover .search-item-icon),
  :global(.search-item.is-selected .search-item-icon) {
    transform: scale(1.14) rotate(-6deg);
  }
  :global(.search-item:hover),
  :global(.search-item.is-selected) {
    background: var(--paper-deep);
  }
  :global(.search-item-body) {
    min-width: 0;
    flex: 1;
  }
  :global(.search-item-title) {
    display: block;
    color: var(--ink);
    font-size: 0.92rem;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  :global(.search-item-desc) {
    display: block;
    margin-top: 0.15rem;
    color: var(--muted);
    font-size: 0.78rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  :global(.search-item-meta) {
    flex: none;
    padding-top: 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--faint);
  }

  .search-foot {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: 0.7rem 1.25rem;
    border-top: 1px solid var(--line);
    font-size: 0.72rem;
    color: var(--muted);
  }
  .search-foot span {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .search-count {
    margin-left: auto;
  }
</style>
