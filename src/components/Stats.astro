---
import { siteConfig } from '../data/site.config';
---

<div class="stats" data-stats>
  {siteConfig.stats.map((stat, i) => (
    <div class="stat" data-reveal style={`--reveal-delay:${i * 90}ms`}>
      <div class="stat-number">
        <span data-count={stat.value}>0</span><em>{stat.suffix}</em>
      </div>
      <span class="stat-label">{stat.label}</span>
    </div>
  ))}
</div>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface-soft);
    backdrop-filter: blur(10px);
    overflow: hidden;
  }
  .stat {
    position: relative;
    padding: clamp(1.5rem, 3vw, 2.3rem) clamp(1rem, 2.5vw, 2rem);
    text-align: center;
  }
  .stat + .stat::before {
    content: '';
    position: absolute;
    left: 0;
    top: 18%;
    bottom: 18%;
    width: 1px;
    background: var(--line);
  }
  .stat-number {
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    background: linear-gradient(135deg, var(--ink), var(--ember));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .stat-number em {
    font-style: normal;
    font-size: 0.55em;
    margin-left: 0.08em;
  }
  .stat-label {
    display: block;
    margin-top: 0.75rem;
    font-size: 0.76rem;
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .stats {
      grid-template-columns: 1fr 1fr;
    }
    .stat:nth-child(3)::before {
      display: none;
    }
  }
</style>
