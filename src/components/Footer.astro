---
import Icon from './Icon.astro';
import { siteConfig } from '../data/site.config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-glow" aria-hidden="true"></div>
  <div class="container-wide footer-inner">
    <div class="footer-brand">
      <a href="/" class="footer-logo">
        <span class="footer-mark">L</span>
        <span>{siteConfig.title}</span>
      </a>
      <p>{siteConfig.description}</p>
      <div class="footer-socials">
        {siteConfig.socials.map((s) => (
          <a href={s.href} aria-label={s.label} title={s.label} rel={s.href.startsWith('http') ? 'noopener' : undefined}>
            <Icon name={s.icon} size={17} />
          </a>
        ))}
      </div>
    </div>

    <div class="footer-nav">
      <div>
        <h3>浏览</h3>
        {siteConfig.nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
      <div>
        <h3>Elsewhere</h3>
        {siteConfig.socials.map((s) => <a href={s.href}>{s.label}<Icon name="arrow-up-right" size={12} /></a>)}
      </div>
      <div>
        <h3>联系</h3>
        <a href={`mailto:${siteConfig.author.email}`}>{siteConfig.author.email}</a>
        <span class="footer-location">{siteConfig.author.location}</span>
        <span class="footer-status"><i></i>{siteConfig.author.status}</span>
      </div>
    </div>
  </div>

  <div class="container-wide footer-bottom">
    <span>© {year} {siteConfig.author.name} · {siteConfig.footerNote}</span>
    <a href="/rss.xml">RSS 订阅 <Icon name="rss" size={13} /></a>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    margin-top: 3rem;
    padding-top: clamp(4rem, 8vw, 6.5rem);
    border-top: 1px solid var(--line);
    background: var(--paper-deep);
  }
  .footer-glow {
    position: absolute;
    top: -180px;
    left: 50%;
    width: 700px;
    height: 320px;
    transform: translateX(-50%);
    background: radial-gradient(ellipse, var(--ember-soft), transparent 70%);
    pointer-events: none;
  }
  .footer-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1.5fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    padding-bottom: 4rem;
  }
  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 600;
  }
  .footer-mark {
    display: grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 0.7rem;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-serif);
    font-size: 1.1rem;
  }
  .footer-brand p {
    max-width: 26rem;
    margin-top: 1.3rem;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.9;
  }
  .footer-socials {
    display: flex;
    gap: 0.55rem;
    margin-top: 1.8rem;
  }
  .footer-socials a {
    display: grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--muted);
    transition: all var(--t-fast) var(--ease-out);
  }
  .footer-socials a:hover {
    color: #fff;
    background: var(--ember);
    border-color: var(--ember);
    transform: translateY(-3px);
  }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .footer-nav h3 {
    margin-bottom: 1.2rem;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 650;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .footer-nav a,
  .footer-location,
  .footer-status {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    margin-bottom: 0.7rem;
    color: var(--ink-soft);
    font-size: 0.86rem;
    transition: color var(--t-fast), transform var(--t-fast);
  }
  .footer-nav a:hover {
    color: var(--ember);
    transform: translateX(3px);
  }
  .footer-status {
    color: var(--mint);
    font-size: 0.8rem;
  }
  .footer-status i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0 4px color-mix(in srgb, currentColor 18%, transparent);
    animation: pulse-dot 2.4s ease-in-out infinite;
  }

  .footer-bottom {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.4rem;
    border-top: 1px solid var(--line);
    font-size: 0.76rem;
    color: var(--muted);
  }
  .footer-bottom a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .footer-bottom a:hover {
    color: var(--ember);
  }

  @media (max-width: 860px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
  @media (max-width: 560px) {
    .footer-nav {
      grid-template-columns: 1fr 1fr;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
