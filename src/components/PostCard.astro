---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { entrySlug, formatDate, readingTime } from '../utils/format';

interface Props {
  post: CollectionEntry<'blog'>;
  variant?: 'feature' | 'default' | 'compact';
  index?: number;
}
const { post, variant = 'default', index = 0 } = Astro.props;
const { title, description, pubDate, cover, coverAlt, tags, category, accent } = post.data;
const href = `/writing/${entrySlug(post)}`;
const minutes = readingTime(post.body);
---

<article
  class:list={['post-card', variant]}
  data-reveal
  data-tilt={variant === 'compact' ? undefined : ''}
  data-tilt-max={variant === 'feature' ? 6.5 : 4.5}
  data-spotlight
  data-accent={accent}
  style={`--reveal-delay:${index * 75}ms`}
>
  <a class="card-link" href={href} aria-label={`阅读：${title}`}>
    <div class="cover">
      <img src={cover} alt={coverAlt ?? title} loading={variant === 'feature' ? 'eager' : 'lazy'} decoding="async" />
      <span class="category">{category}</span>
      <span class="cover-arrow"><Icon name="arrow-up-right" size={18} /></span>
      <span class="cover-shine" aria-hidden="true"></span>
    </div>
    <div class="body">
      <div class="meta">
        <span><Icon name="calendar" size={13} />{formatDate(pubDate, 'short')}</span>
        <span class="meta-dot"></span>
        <span><Icon name="clock" size={13} />{minutes} 分钟</span>
      </div>
      <h3>{title}</h3>
      <p>{description}</p>
      <div class="card-foot">
        <div class="tags">
          {tags.slice(0, 3).map((tag) => <span class="tag">#{tag}</span>)}
        </div>
        <span class="read-more">阅读 <Icon name="arrow-right" size={14} /></span>
      </div>
    </div>
  </a>
</article>

<style>
  .post-card {
    --card-accent: var(--ember);
    position: relative;
    height: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
    transition: transform var(--t-base) var(--ease-out), border-color var(--t-base),
      box-shadow var(--t-base) var(--ease-out);
  }
  .post-card[data-accent='indigo'] { --card-accent: var(--indigo); }
  .post-card[data-accent='mint'] { --card-accent: var(--mint); }
  .post-card[data-accent='rose'] { --card-accent: var(--rose); }
  .post-card:hover {
    translate: 0 -6px;
    border-color: color-mix(in srgb, var(--card-accent) 40%, transparent);
    box-shadow: var(--shadow-lg);
  }

  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .cover {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--paper-deep);
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 800ms var(--ease-out), filter var(--t-base);
  }
  .post-card:hover .cover img {
    transform: scale(1.055);
  }
  .cover-shine {
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, transparent 30%, rgba(255, 255, 255, 0.24) 48%, transparent 62%);
    transform: translateX(-120%);
    transition: transform 900ms var(--ease-out);
  }
  .post-card:hover .cover-shine {
    transform: translateX(120%);
  }
  .category {
    position: absolute;
    top: 0.9rem;
    left: 0.9rem;
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(8px);
    color: #24221f;
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.05em;
  }
  .cover-arrow {
    position: absolute;
    right: 0.9rem;
    bottom: 0.9rem;
    display: grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow-sm);
    transform: translateY(8px) rotate(-30deg);
    opacity: 0;
    transition: all var(--t-base) var(--ease-spring);
  }
  .post-card:hover .cover-arrow {
    opacity: 1;
    transform: none;
    background: var(--card-accent);
    color: #fff;
  }

  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.6rem 1.7rem 1.5rem;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--muted);
    font-size: 0.75rem;
    font-family: var(--font-mono);
  }
  .meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
  }
  .meta-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--faint);
  }
  h3 {
    margin-top: 0.9rem;
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: -0.02em;
    transition: color var(--t-fast);
  }
  .post-card:hover h3 {
    color: var(--card-accent);
  }
  .body p {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-top: 0.65rem;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.8;
  }
  .card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1.35rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .tag {
    font-size: 0.68rem;
    padding: 0.22rem 0.55rem;
  }
  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex: none;
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .read-more svg {
    transition: transform var(--t-base) var(--ease-out);
  }
  .post-card:hover .read-more svg {
    transform: translateX(4px);
    color: var(--card-accent);
  }

  /* Featured: wide editorial split with a slow-rotating gradient hairline */
  @property --ring-angle {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }
  @keyframes ring-spin {
    to {
      --ring-angle: 360deg;
    }
  }
  .post-card.feature {
    border-radius: var(--radius-xl);
  }
  .post-card.feature::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: inherit;
    padding: 1px;
    background: conic-gradient(from var(--ring-angle), var(--ember), var(--indigo), var(--ember));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask-composite: exclude;
    opacity: 0.45;
    pointer-events: none;
    animation: ring-spin 8s linear infinite;
  }
  .post-card.feature .card-link {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
  }
  .post-card.feature .cover {
    aspect-ratio: auto;
    min-height: 100%;
  }
  .post-card.feature .body {
    justify-content: center;
    padding: clamp(2rem, 4vw, 3.5rem);
  }
  .post-card.feature h3 {
    font-size: clamp(1.8rem, 3.6vw, 2.7rem);
    line-height: 1.3;
  }
  .post-card.feature .body p {
    -webkit-line-clamp: 4;
    font-size: 0.95rem;
  }

  /* Compact: small horizontal row — cover stretches to the card's full height */
  .post-card.compact .card-link {
    flex-direction: row;
  }
  .post-card.compact .cover {
    width: 110px;
    flex: none;
    aspect-ratio: auto;
    min-height: 100%;
  }
  .post-card.compact .body {
    padding: 1rem 1.1rem;
  }
  .post-card.compact h3 {
    margin-top: 0.4rem;
    font-size: 1rem;
  }
  .post-card.compact .body p,
  .post-card.compact .card-foot {
    display: none;
  }

  @media (max-width: 760px) {
    .post-card.feature .card-link {
      grid-template-columns: 1fr;
    }
    .post-card.feature .cover {
      aspect-ratio: 16 / 10;
      min-height: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cover-shine {
      display: none;
    }
  }
</style>
