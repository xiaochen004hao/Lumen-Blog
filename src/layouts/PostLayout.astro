---
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ShareBar from '../components/ShareBar.astro';
import Comments from '../components/Comments.astro';
import type { CollectionEntry } from 'astro:content';
import { siteConfig } from '../data/site.config';
import { formatDate, readingTime, tagUrl } from '../utils/format';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  post: CollectionEntry<'blog'>;
  headings: Heading[];
}
const { post, headings } = Astro.props;
const { title, description, pubDate, updatedDate, cover, coverAlt, tags, category } = post.data;
const minutes = readingTime(post.body);
const canonical = new URL(`/writing/${post.id}`, siteConfig.url).href;
---

<BaseLayout
  title={title}
  description={description}
  ogImage={cover}
  article={true}
  publishedTime={pubDate.toISOString()}
  tags={tags}
>
  <article class="article">
    <header class="post-hero">
      <div class="hero-media" data-hero-media aria-hidden="true">
        <img src={cover} alt={coverAlt ?? ''} />
        <div class="hero-veil"></div>
      </div>
      <div class="container hero-inner">
        <nav class="breadcrumb" aria-label="面包屑">
          <a href="/">首页</a><Icon name="arrow-right" size={12} />
          <a href="/writing">文章</a><Icon name="arrow-right" size={12} />
          <span>{category}</span>
        </nav>
        <div class="hero-copy" data-reveal>
          <span class="hero-tag"><span class="dot"></span>{category} · ESSAY</span>
          <h1 transition:name="page-heading">{title}</h1>
          <p class="hero-desc">{description}</p>
          <div class="hero-meta">
            <span class="author-chip">
              <img src={siteConfig.author.avatar} alt="" width="34" height="34" />
              <span><strong>{siteConfig.author.name}</strong><small>{siteConfig.author.role}</small></span>
            </span>
            <span class="meta-divider"></span>
            <span><Icon name="calendar" size={14} />{formatDate(pubDate)}</span>
            <span><Icon name="clock" size={14} />约 {minutes} 分钟</span>
            {updatedDate && <span><Icon name="sparkles" size={14} />更新于 {formatDate(updatedDate, 'short')}</span>}
          </div>
        </div>
      </div>
    </header>

    <div class="container post-layout">
      <aside class="left-rail">
        <a class="back-link" href="/writing"><Icon name="arrow-left" size={14} /> 返回文章列表</a>
        <TableOfContents headings={headings} />
      </aside>

      <div class="content prose">
        <slot />
      </div>

      <aside class="right-rail">
        <div class="rail-sticky">
          <span class="rail-label">本文目录之外</span>
          <div class="rail-card">
            <Icon name="quote" size={20} />
            <p>如果这篇文章让你停下来想了一会儿，那它就完成了使命。</p>
          </div>
          <div class="rail-line"></div>
          <span class="rail-label">SHARE</span>
          <ShareBar title={title} url={canonical} />
        </div>
      </aside>
    </div>

    <div class="container post-end">
      <div class="tags-row">
        <span class="tags-label"><Icon name="hash" size={14} />标签</span>
        {tags.map((tag) => <a class="tag" href={tagUrl(tag)}>#{tag}</a>)}
      </div>
      <div class="end-share">
        <ShareBar title={title} url={canonical} />
      </div>

      <div class="author-card" data-reveal data-spotlight>
        <img src={siteConfig.author.avatar} alt={siteConfig.author.name} width="88" height="88" />
        <div>
          <span class="author-eyebrow">ABOUT THE AUTHOR</span>
          <h3>{siteConfig.author.name} <small>/ {siteConfig.author.englishName}</small></h3>
          <p>{siteConfig.author.bio}</p>
          <div class="author-links">
            <a href={`/about`}>了解更多 <Icon name="arrow-right" size={14} /></a>
            <a href={`mailto:${siteConfig.author.email}`}><Icon name="mail" size={14} /> 联系我</a>
          </div>
        </div>
      </div>
    </div>

    <div class="container related-wrap">
      <Comments />
      <slot name="related" />
    </div>
  </article>
</BaseLayout>

<style>
  .post-hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(2rem, 5vw, 4rem);
  }
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-media img {
    position: absolute;
    inset: -10% 0;
    width: 100%;
    height: 120%;
    object-fit: cover;
    opacity: 0.5;
    filter: saturate(0.85);
    translate: 0 var(--hero-parallax, 0px);
    will-change: translate;
  }
  .hero-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--paper) 0%, color-mix(in srgb, var(--paper) 82%, transparent) 42%, var(--paper) 98%);
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    padding-top: clamp(4rem, 11vw, 9rem);
    padding-bottom: clamp(3rem, 7vw, 5.5rem);
  }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
    font-size: 0.76rem;
  }
  .breadcrumb a:hover {
    color: var(--ember);
  }
  .breadcrumb span {
    color: var(--ink-soft);
  }
  .hero-copy {
    max-width: 850px;
    margin-top: 2.4rem;
  }
  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    background: var(--surface-soft);
    backdrop-filter: blur(8px);
    font-size: 0.7rem;
    font-weight: 650;
    letter-spacing: 0.12em;
  }
  .hero-tag .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ember);
    box-shadow: 0 0 0 4px var(--ember-soft);
  }
  h1 {
    margin-top: 1.5rem;
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 6vw, 4.6rem);
    font-weight: 600;
    line-height: 1.18;
    letter-spacing: -0.045em;
  }
  .hero-desc {
    max-width: 42rem;
    margin-top: 1.4rem;
    color: var(--ink-soft);
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.9;
  }
  .hero-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.3rem;
    margin-top: 2.5rem;
    color: var(--muted);
    font-size: 0.8rem;
  }
  .hero-meta > span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .author-chip {
    gap: 0.7rem !important;
  }
  .author-chip img {
    border-radius: 50%;
    border: 2px solid var(--surface);
    box-shadow: var(--shadow-sm);
  }
  .author-chip span {
    display: flex;
    flex-direction: column;
    line-height: 1.35;
  }
  .author-chip strong {
    color: var(--ink);
    font-size: 0.85rem;
  }
  .author-chip small {
    font-size: 0.68rem;
  }
  .meta-divider {
    width: 1px;
    height: 24px;
    background: var(--line-strong);
  }

  .post-layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr) 210px;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
    padding-top: 2rem;
  }
  .left-rail,
  .right-rail {
    min-width: 0;
  }
  .left-rail {
    position: sticky;
    top: calc(var(--header-h) + 1.75rem);
    align-self: start;
    padding: 1rem 0.9rem 1.2rem 0;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--paper) 86%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 2.2rem;
    color: var(--muted);
    font-size: 0.78rem;
  }
  .back-link:hover {
    color: var(--ember);
  }
  .content {
    min-width: 0;
    padding-block: 1rem 3rem;
  }
  .rail-sticky {
    position: sticky;
    top: calc(var(--header-h) + 3rem);
  }
  .rail-label {
    display: block;
    margin-bottom: 0.8rem;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--faint);
  }
  .rail-card {
    padding: 1.2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--ember);
  }
  .rail-card p {
    margin-top: 0.6rem;
    color: var(--ink-soft);
    font-family: var(--font-serif);
    font-size: 0.92rem;
    font-style: italic;
    line-height: 1.75;
  }
  .rail-line {
    height: 1px;
    margin: 2rem 0;
    background: var(--line);
  }

  .post-end {
    padding-top: 1rem;
  }
  .tags-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tags-label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-right: 0.5rem;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 600;
  }
  .end-share {
    margin-top: 2rem;
    padding-block: 1.3rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .author-card {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 1.8rem;
    margin-top: 3.5rem;
    padding: clamp(1.6rem, 4vw, 2.6rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: linear-gradient(120deg, var(--surface), var(--paper-deep));
  }
  .author-card img {
    border-radius: var(--radius-md);
  }
  .author-eyebrow {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--ember);
  }
  .author-card h3 {
    margin-top: 0.4rem;
    font-family: var(--font-serif);
    font-size: 1.5rem;
  }
  .author-card h3 small {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--muted);
  }
  .author-card p {
    max-width: 40rem;
    margin-top: 0.7rem;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.9;
  }
  .author-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    margin-top: 1.3rem;
  }
  .author-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    font-weight: 600;
  }
  .author-links a:hover {
    color: var(--ember);
  }
  .related-wrap {
    padding-top: 3rem;
  }

  @media (max-width: 1180px) {
    .post-layout {
      grid-template-columns: 190px minmax(0, 1fr);
    }
    .right-rail {
      display: none;
    }
  }
  @media (max-width: 860px) {
    .post-layout {
      grid-template-columns: 1fr;
    }
    .left-rail {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .hero-meta {
      gap: 0.8rem 1rem;
    }
    .meta-divider {
      display: none;
    }
    .author-card {
      grid-template-columns: 1fr;
      justify-items: start;
    }
  }
</style>
