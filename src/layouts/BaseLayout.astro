---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GridGlow from '../components/GridGlow.astro';
import SearchDialog from '../components/SearchDialog.astro';
import ProgressBar from '../components/ProgressBar.astro';
import BackToTop from '../components/BackToTop.astro';
import { siteConfig } from '../data/site.config';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  article?: boolean;
  publishedTime?: string;
  tags?: string[];
}

const {
  title,
  description = siteConfig.description,
  ogImage = '/og-default.svg',
  article = false,
  publishedTime,
  tags = [],
} = Astro.props;

const pageTitle = title ? `${title} · ${siteConfig.title}` : `${siteConfig.title} — ${siteConfig.tagline}`;
const canonical = new URL(Astro.url.pathname, siteConfig.url).href;
const ogImageUrl = new URL(ogImage, siteConfig.url).href;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': article ? 'BlogPosting' : 'WebSite',
  name: siteConfig.title,
  headline: title ?? siteConfig.tagline,
  description,
  url: canonical,
  image: ogImageUrl,
  inLanguage: siteConfig.locale,
  ...(article && publishedTime ? { datePublished: publishedTime } : {}),
  ...(article ? { keywords: tags.join(', ') } : {}),
  author: {
    '@type': 'Person',
    name: siteConfig.author.name,
    jobTitle: siteConfig.author.role,
    email: siteConfig.author.email,
  },
  publisher: {
    '@type': 'Person',
    name: siteConfig.author.name,
  },
};
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={[...siteConfig.keywords, ...tags].join(', ')} />
    <meta name="theme-color" content={siteConfig.themeColor} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.title} RSS`} href="/rss.xml" />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:title" content={title ?? pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={siteConfig.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Set theme before first paint to prevent a flash of the wrong theme -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('lumen-theme');
          var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
        document.documentElement.classList.add('js-ready');
      })();
    </script>

    <ClientRouter />
  </head>

  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <ProgressBar />
    <GridGlow />
    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />
    <SearchDialog />
    <BackToTop />

    <script>
      type SearchItem = {
        title: string;
        description: string;
        url: string;
        type: string;
        tags: string[];
        date: string;
        text: string;
      };

      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let globalsReady = false;
      let revealObserver: IntersectionObserver | null = null;
      let statsObserver: IntersectionObserver | null = null;
      let searchIndex: SearchItem[] | null = null;
      let selectedResult = -1;
      let currentResults: SearchItem[] = [];

      const escapeHtml = (value: string) =>
        value.replace(/[&<>"']/g, (char) =>
          ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char] as string
        );

      /* ---------------- Theme ---------------- */
      function currentTheme(): 'light' | 'dark' {
        return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
      }

      function applyTheme(theme: 'light' | 'dark') {
        document.documentElement.setAttribute('data-theme', theme);
        try {
          localStorage.setItem('lumen-theme', theme);
        } catch (_) {
          /* storage may be blocked; the toggle still works for this page */
        }
      }

      function restoreTheme() {
        let saved: string | null = null;
        try {
          saved = localStorage.getItem('lumen-theme');
        } catch (_) {
          /* ignore */
        }
        const theme =
          saved === 'dark' || saved === 'light'
            ? saved
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.classList.add('js-ready');
      }

      function initTheme() {
        document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
          if (button.dataset.bound) return;
          button.dataset.bound = '1';
          button.addEventListener('click', (event) => {
            const next = currentTheme() === 'dark' ? 'light' : 'dark';
            const root = document.documentElement;

            if (prefersReduced || !document.startViewTransition) {
              applyTheme(next);
              return;
            }

            const mouse = event as MouseEvent;
            const rect = button.getBoundingClientRect();
            const x = mouse.clientX || rect.left + rect.width / 2;
            const y = mouse.clientY || rect.top + rect.height / 2;
            root.style.setProperty('--theme-x', `${x}px`);
            root.style.setProperty('--theme-y', `${y}px`);
            root.classList.add('theme-switching');

            const transition = document.startViewTransition(() => applyTheme(next));
            const cleanup = () => root.classList.remove('theme-switching');
            transition.finished.then(cleanup, cleanup);
          });
        });
      }

      /* ---------------- Search ---------------- */
      function searchOverlay() {
        return document.querySelector<HTMLElement>('[data-search-overlay]');
      }

      function resultMarkup(item: SearchItem, index: number) {
        const iconSvg =
          item.type === '文章'
            ? '<path d="M5 9h14M4 15h14M10 3 8 21M16 3l-2 18"/>'
            : '<path d="m12 3 1.7 4.8L18.5 9.5l-4.8 1.7L12 16l-1.7-4.8L5.5 9.5l4.8-1.7L12 3Z"/>';
        return `<button class="search-item${index === 0 ? ' is-selected' : ''}" type="button" style="--i:${index}" data-search-item data-url="${escapeHtml(item.url)}">
          <span class="search-item-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${iconSvg}</svg></span>
          <span class="search-item-body">
            <span class="search-item-title">${escapeHtml(item.title)}</span>
            <span class="search-item-desc">${escapeHtml(item.description || item.text.slice(0, 90))}</span>
          </span>
          <span class="search-item-meta">${escapeHtml(item.date)}</span>
        </button>`;
      }

      function renderResults(query: string) {
        const overlay = searchOverlay();
        if (!overlay) return;
        const container = overlay.querySelector<HTMLElement>('[data-search-results]')!;
        const count = overlay.querySelector<HTMLElement>('[data-search-count]')!;
        const q = query.trim().toLowerCase();

        if (!q) {
          currentResults = [];
          selectedResult = -1;
          container.innerHTML = `<div class="search-hint">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="m12 3 1.7 4.8L18.5 9.5l-4.8 1.7L12 16l-1.7-4.8L5.5 9.5l4.8-1.7L12 3Z"/></svg>
            <div><strong>开始探索这座花园</strong><span>输入关键词，或试试「设计」「Astro」「思考」</span></div>
          </div>`;
          count.textContent = '';
          return;
        }

        const items = searchIndex ?? [];
        const scored = items
          .map((item) => {
            const title = item.title.toLowerCase();
            const desc = (item.description || '').toLowerCase();
            const tags = item.tags.join(' ').toLowerCase();
            const body = item.text.toLowerCase();
            let score = 0;
            if (title.includes(q)) score += 6;
            if (tags.includes(q)) score += 4;
            if (desc.includes(q)) score += 3;
            if (body.includes(q)) score += 1;
            return { item, score };
          })
          .filter((entry) => entry.score > 0)
          .sort((a, b) => b.score - a.score || b.item.date.localeCompare(a.item.date))
          .slice(0, 8)
          .map((entry) => entry.item);

        currentResults = scored;
        selectedResult = scored.length ? 0 : -1;
        count.textContent = scored.length ? `${scored.length} 条结果` : '';
        container.innerHTML = scored.length
          ? scored.map(resultMarkup).join('')
          : `<div class="search-empty">没有找到「${escapeHtml(query)}」相关内容<br><span>换个关键词试试吧</span></div>`;
      }

      function moveSelection(delta: number) {
        const overlay = searchOverlay();
        if (!overlay || !currentResults.length) return;
        const nodes = overlay.querySelectorAll<HTMLElement>('[data-search-item]');
        nodes[selectedResult]?.classList.remove('is-selected');
        selectedResult = (selectedResult + delta + nodes.length) % nodes.length;
        const next = nodes[selectedResult];
        next?.classList.add('is-selected');
        next?.scrollIntoView({ block: 'nearest' });
      }

      async function openSearch() {
        const overlay = searchOverlay();
        if (!overlay || !overlay.hidden) return;
        overlay.hidden = false;
        document.body.style.overflow = 'hidden';
        const input = overlay.querySelector<HTMLInputElement>('[data-search-input]')!;
        input.value = '';
        renderResults('');
        input.focus();

        if (!searchIndex) {
          try {
            const response = await fetch('/search-index.json');
            searchIndex = await response.json();
            if (input.value.trim()) renderResults(input.value);
          } catch (_) {
            overlay.querySelector<HTMLElement>('[data-search-results]')!.innerHTML =
              '<div class="search-empty">搜索索引暂时不可用</div>';
          }
        }
      }

      function closeSearch() {
        const overlay = searchOverlay();
        if (!overlay || overlay.hidden) return;
        overlay.hidden = true;
        document.body.style.overflow = '';
      }

      /* ---------------- Scroll-driven UI ---------------- */
      function updateScrollUI() {
        const y = window.scrollY;
        const max = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
        const progress = max ? (y / max) * 100 : 0;

        document.querySelector('[data-site-header]')?.classList.toggle('is-scrolled', y > 12);
        document.querySelector<HTMLElement>('[data-progress-bar]')?.style.setProperty('width', `${progress}%`);

        const backTop = document.querySelector<HTMLElement>('[data-back-to-top]');
        backTop?.classList.toggle('is-visible', y > 520);
        backTop?.style.setProperty('--scroll-ring', `${progress}%`);

        // Gentle parallax, applied via the independent `translate` property so it
        // never fights with the entrance animations that use `transform`.
        const heroVisual = document.querySelector<HTMLElement>('[data-parallax]');
        if (heroVisual && y < window.innerHeight * 1.4) {
          heroVisual.style.setProperty('--parallax-y', `${Math.min(y * 0.11, 90)}px`);
        }
        const heroMedia = document.querySelector<HTMLElement>('[data-hero-media]');
        if (heroMedia && y < window.innerHeight * 1.1) {
          heroMedia.style.setProperty('--hero-parallax', `${y * 0.16}px`);
        }

        const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
        if (!links.length) return;
        const offset = window.innerHeight * 0.32;
        let active = 0;
        links.forEach((link, index) => {
          const target = document.getElementById(link.dataset.tocLink || '');
          if (target && target.getBoundingClientRect().top <= offset) active = index;
        });
        links.forEach((link, index) => link.classList.toggle('is-active', index === active));
        const tocProgress = ((active + 1) / links.length) * 100;
        document.querySelector<HTMLElement>('[data-toc-progress]')?.style.setProperty('width', `${tocProgress}%`);
        const percent = document.querySelector<HTMLElement>('[data-toc-percent]');
        if (percent) percent.textContent = `${Math.round(tocProgress)}%`;
      }

      /* ---------------- Reveal, stats, code, filters ---------------- */
      function initReveal() {
        revealObserver?.disconnect();
        const elements = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));

        // Long-form reading: reveal prose blocks one by one as they enter the
        // viewport. Only elements below the fold are tagged, so nothing that is
        // already on screen can flicker.
        document.querySelectorAll<HTMLElement>('.prose > *').forEach((el) => {
          if (el.hasAttribute('data-reveal')) return;
          if (el.getBoundingClientRect().top < window.innerHeight * 0.92) return;
          el.setAttribute('data-reveal', '');
          elements.push(el);
        });

        if (prefersReduced || !('IntersectionObserver' in window)) {
          elements.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              // Anything already scrolled past (e.g. after an anchor jump or a
              // very fast scroll) must never stay hidden forever.
              if (entry.isIntersecting || entry.boundingClientRect.top < 0) {
                entry.target.classList.add('is-visible');
                revealObserver?.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.06, rootMargin: '0px 0px -32px 0px' }
        );
        elements.forEach((el) => {
          if (el.getBoundingClientRect().top < 0) {
            el.classList.add('is-visible');
            return;
          }
          revealObserver!.observe(el);
        });
      }

      function initStats() {
        statsObserver?.disconnect();
        const block = document.querySelector('[data-stats]');
        if (!block) return;
        const animate = () => {
          block.querySelectorAll<HTMLElement>('[data-count]').forEach((node) => {
            const target = Number(node.dataset.count || 0);
            const started = performance.now();
            const duration = 1500;
            const step = (now: number) => {
              const p = Math.min(1, (now - started) / duration);
              const eased = 1 - Math.pow(1 - p, 3);
              node.textContent = String(Math.round(target * eased));
              if (p < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
          });
        };
        if (prefersReduced || !('IntersectionObserver' in window)) {
          block.querySelectorAll<HTMLElement>('[data-count]').forEach((n) => (n.textContent = n.dataset.count || '0'));
          return;
        }
        statsObserver = new IntersectionObserver(
          (entries) => {
            if (entries.some((e) => e.isIntersecting)) {
              animate();
              statsObserver?.disconnect();
            }
          },
          { threshold: 0.3 }
        );
        statsObserver.observe(block);
      }

      async function copyText(text: string) {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch (_) {
          const area = document.createElement('textarea');
          area.value = text;
          area.style.position = 'fixed';
          area.style.opacity = '0';
          document.body.appendChild(area);
          area.select();
          const ok = document.execCommand('copy');
          area.remove();
          return ok;
        }
      }

      function initCodeCopy() {
        document.querySelectorAll<HTMLElement>('.prose pre').forEach((pre) => {
          if (pre.querySelector('.code-copy')) return;
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'code-copy';
          button.innerHTML =
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 4 4L19 6"/></svg><span>复制</span>';
          button.addEventListener('click', async () => {
            const code = pre.querySelector('code')?.textContent ?? '';
            const ok = await copyText(code);
            const label = button.querySelector('span')!;
            label.textContent = ok ? '已复制' : '复制失败';
            window.setTimeout(() => (label.textContent = '复制'), 1600);
          });
          pre.appendChild(button);
        });
      }

      function initFilters() {
        const grid = document.querySelector<HTMLElement>('[data-post-grid]');
        if (!grid) return;

        document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((button) => {
          if (button.dataset.bound) return;
          button.dataset.bound = '1';
          button.addEventListener('click', () => {
            const tag = button.dataset.filter || 'all';
            document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) => b.classList.toggle('is-active', b === button));
            grid.querySelectorAll<HTMLElement>('[data-post-card]').forEach((card) => {
              const tags = (card.dataset.tags || '').split('|').filter(Boolean);
              const visible = tag === 'all' || tags.includes(tag);
              card.classList.toggle('is-filtered-out', !visible);
            });
          });
        });

        document.querySelectorAll<HTMLButtonElement>('[data-view-toggle]').forEach((button) => {
          if (button.dataset.bound) return;
          button.dataset.bound = '1';
          button.addEventListener('click', () => {
            const view = button.dataset.viewToggle || 'grid';
            grid.dataset.view = view;
            document.querySelectorAll<HTMLButtonElement>('[data-view-toggle]').forEach((b) =>
              b.classList.toggle('is-active', b === button)
            );
          });
        });
      }

      function initShare() {
        document.querySelectorAll<HTMLButtonElement>('[data-share-copy]').forEach((button) => {
          if (button.dataset.bound) return;
          button.dataset.bound = '1';
          button.addEventListener('click', async () => {
            const bar = button.closest<HTMLElement>('[data-share-bar]');
            await showShareResult(bar, await copyText(bar?.dataset.shareUrl || window.location.href));
          });
        });

        document.querySelectorAll<HTMLButtonElement>('[data-share-native]').forEach((button) => {
          if (!navigator.share) {
            button.hidden = true;
            return;
          }
          if (button.dataset.bound) return;
          button.dataset.bound = '1';
          button.addEventListener('click', async () => {
            const bar = button.closest<HTMLElement>('[data-share-bar]');
            try {
              await navigator.share({ title: document.title, url: bar?.dataset.shareUrl || window.location.href });
            } catch (_) {
              /* 用户取消 */
            }
          });
        });
      }

      async function showShareResult(bar: HTMLElement | null, ok: boolean) {
        const toast = bar?.querySelector<HTMLElement>('[data-share-toast]');
        if (toast) {
          toast.textContent = ok ? '链接已复制' : '复制失败';
          toast.classList.add('is-visible');
          window.setTimeout(() => toast.classList.remove('is-visible'), 1600);
        }
      }

      function initNewsletter() {
        document.querySelectorAll<HTMLFormElement>('[data-newsletter]').forEach((form) => {
          if (form.dataset.bound) return;
          form.dataset.bound = '1';
          form.addEventListener('submit', (event) => {
            const action = form.getAttribute('action');
            if (action && action !== '#') return;
            event.preventDefault();
            const note = form.querySelector<HTMLElement>('[data-form-note]');
            if (note) {
              note.textContent = '✓ 已收到！这只是一个演示表单，接入你的邮件服务后即可真正订阅。';
              note.classList.add('is-success');
            }
            form.querySelector('input')?.setAttribute('disabled', 'true');
          });
        });
      }

      function initMenu() {
        const button = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
        const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
        if (!button || !menu || button.dataset.bound) return;
        button.dataset.bound = '1';
        const close = () => {
          menu.classList.remove('is-open');
          menu.setAttribute('aria-hidden', 'true');
          button.setAttribute('aria-expanded', 'false');
          button.innerHTML =
            '<svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>';
        };
        button.addEventListener('click', () => {
          const open = !menu.classList.contains('is-open');
          menu.classList.toggle('is-open', open);
          menu.setAttribute('aria-hidden', String(!open));
          button.setAttribute('aria-expanded', String(open));
          button.innerHTML = open
            ? '<svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>'
            : '<svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>';
        });
        menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
        document.addEventListener('astro:before-swap', close);
      }

      /* ---------------- Interaction flourishes ---------------- */
      function initTilt() {
        if (prefersReduced || window.matchMedia('(hover: none)').matches) return;
        document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((element) => {
          if (element.dataset.tiltBound) return;
          element.dataset.tiltBound = '1';
          const max = Number(element.dataset.tiltMax || 5);
          element.addEventListener('pointermove', (event) => {
            const rect = element.getBoundingClientRect();
            const px = (event.clientX - rect.left) / rect.width - 0.5;
            const py = (event.clientY - rect.top) / rect.height - 0.5;
            const rx = (-py * max * 2).toFixed(2);
            const ry = (px * max * 2).toFixed(2);
            // `rotate` is an independent property, so it composes cleanly with
            // the transform-based entrance animations instead of clobbering them.
            const angle = Math.hypot(Number(rx), Number(ry));
            if (angle < 0.05) {
              element.style.rotate = '0deg';
              return;
            }
            element.style.rotate = `${Number(rx) / angle} ${Number(ry) / angle} 0 ${angle.toFixed(2)}deg`;
          });
          element.addEventListener('pointerleave', () => {
            element.style.rotate = '0deg';
          });
        });
      }

      function initSpotlight() {
        document.querySelectorAll<HTMLElement>('[data-spotlight]').forEach((element) => {
          if (element.dataset.spotBound) return;
          element.dataset.spotBound = '1';
          element.addEventListener('pointermove', (event) => {
            const rect = element.getBoundingClientRect();
            element.style.setProperty('--spot-x', `${event.clientX - rect.left}px`);
            element.style.setProperty('--spot-y', `${event.clientY - rect.top}px`);
          });
          element.addEventListener('pointerleave', () => {
            element.style.removeProperty('--spot-x');
            element.style.removeProperty('--spot-y');
          });
        });
      }

      function initMagnetic() {
        if (prefersReduced) return;
        document.querySelectorAll<HTMLElement>('.btn:not(.btn-icon)').forEach((element) => {
          if (element.dataset.magBound) return;
          element.dataset.magBound = '1';
          element.addEventListener('pointermove', (event) => {
            const rect = element.getBoundingClientRect();
            const dx = event.clientX - rect.left - rect.width / 2;
            const dy = event.clientY - rect.top - rect.height / 2;
            element.style.setProperty('--mag-x', `${(dx * 0.14).toFixed(2)}px`);
            element.style.setProperty('--mag-y', `${(dy * 0.2).toFixed(2)}px`);
          });
          element.addEventListener('pointerleave', () => {
            element.style.removeProperty('--mag-x');
            element.style.removeProperty('--mag-y');
          });
        });
      }

      function initHeadingAnchors() {
        document.querySelectorAll<HTMLElement>('.prose h2[id], .prose h3[id]').forEach((heading) => {
          if (heading.querySelector('.heading-anchor')) return;
          const anchor = document.createElement('a');
          anchor.className = 'heading-anchor';
          anchor.href = `#${heading.id}`;
          anchor.textContent = '#';
          anchor.setAttribute('aria-label', '复制此标题链接');
          heading.appendChild(anchor);
        });
      }

      /* ---------------- Global wiring (once) ---------------- */
      function bootGlobals() {
        if (globalsReady) return;
        globalsReady = true;

        // Background grid glow follows the pointer (rAF-throttled, hover devices only)
        if (!prefersReduced && !window.matchMedia('(hover: none)').matches) {
          let glowTicking = false;
          window.addEventListener(
            'pointermove',
            (event) => {
              if (glowTicking) return;
              glowTicking = true;
              requestAnimationFrame(() => {
                const root = document.documentElement;
                root.style.setProperty('--glow-x', `${event.clientX}px`);
                root.style.setProperty('--glow-y', `${event.clientY}px`);
                glowTicking = false;
              });
            },
            { passive: true }
          );
        }

        let ticking = false;
        window.addEventListener(
          'scroll',
          () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(() => {
              updateScrollUI();
              ticking = false;
            });
          },
          { passive: true }
        );
        window.addEventListener('resize', updateScrollUI, { passive: true });

        document.addEventListener('keydown', (event) => {
          const key = event.key.toLowerCase();
          if ((event.metaKey || event.ctrlKey) && key === 'k') {
            event.preventDefault();
            openSearch();
            return;
          }
          if (key === 'escape') {
            closeSearch();
            return;
          }
          const overlay = searchOverlay();
          if (!overlay || overlay.hidden) return;
          const input = overlay.querySelector<HTMLInputElement>('[data-search-input]');
          if (event.target !== input) return;
          if (key === 'arrowdown') {
            event.preventDefault();
            moveSelection(1);
          } else if (key === 'arrowup') {
            event.preventDefault();
            moveSelection(-1);
          } else if (key === 'enter' && currentResults[selectedResult]) {
            event.preventDefault();
            window.location.href = currentResults[selectedResult].url;
          }
        });

        document.addEventListener('click', (event) => {
          const target = event.target as HTMLElement;
          if (target.closest('[data-search-open]')) openSearch();
          if (target.closest('[data-search-close]')) closeSearch();
          const result = target.closest<HTMLElement>('[data-search-item]');
          if (result?.dataset.url) window.location.href = result.dataset.url;
          if (target.closest('[data-back-to-top]')) window.scrollTo({ top: 0, behavior: prefersReduced ? 'auto' : 'smooth' });
        });

        document.addEventListener('astro:before-swap', () => {
          closeSearch();
          document.body.style.overflow = '';
          document.documentElement.classList.remove('theme-switching');
        });

        // ClientRouter replaces <html> attributes from the incoming document,
        // which would otherwise reset the theme to light until a hard refresh.
        document.addEventListener('astro:after-swap', restoreTheme);
      }

      function initPage() {
        // The body element is replaced on every client-side navigation,
        // so this flag is naturally reset without leaking state between pages.
        if (document.body.dataset.lumenInit === '1') return;
        document.body.dataset.lumenInit = '1';
        bootGlobals();
        initTheme();
        initMenu();
        initReveal();
        initStats();
        initCodeCopy();
        initFilters();
        initShare();
        initNewsletter();
        initSpotlight();
        initMagnetic();
        initTilt();
        initHeadingAnchors();
        updateScrollUI();

        const input = document.querySelector<HTMLInputElement>('[data-search-input]');
        input?.addEventListener('input', (event) => renderResults((event.target as HTMLInputElement).value));
      }

      document.addEventListener('astro:page-load', initPage);
      if (document.readyState !== 'loading') requestAnimationFrame(initPage);
    </script>
  </body>
</html>
