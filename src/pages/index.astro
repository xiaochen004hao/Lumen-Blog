---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Aurora from '../components/Aurora.astro';
import Icon from '../components/Icon.astro';
import Reveal from '../components/Reveal.astro';
import PostCard from '../components/PostCard.astro';
import NoteCard from '../components/NoteCard.astro';
import Stats from '../components/Stats.astro';
import Subscribe from '../components/Subscribe.astro';
import { siteConfig } from '../data/site.config';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const allNotes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featured = allPosts.find((post) => post.data.featured) ?? allPosts[0];
const restPosts = allPosts.filter((post) => post.id !== featured?.id).slice(0, 3);
const latestNotes = allNotes.slice(0, 3);

const marqueeWords = ['DESIGN', 'CODE', 'WRITING', 'SLOW THINKING', 'ASTRO', 'INTERACTION', 'TYPEGRAPHY', 'CURIOSITY'];
---

<BaseLayout>
  <section class="hero">
    <Aurora />
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="status-pill" style="--i:0">
          <span class="status-dot"></span>
          {siteConfig.author.status}
          <span class="status-sep"></span>
          <span class="status-sub">数字花园 · 持续生长中</span>
        </div>

        <div class="hero-eyebrow" style="--i:1">{siteConfig.hero.eyebrow}</div>

        <h1 class="hero-title" transition:name="page-heading">
          {siteConfig.hero.lines.map((line, i) => (
            <span class="hero-line" style={`--i:${i + 2}`}>
              {line.split(siteConfig.hero.highlight).map((part, j, arr) => (
                <>{part}{j < arr.length - 1 && <em>{siteConfig.hero.highlight}<svg viewBox="0 0 200 14" preserveAspectRatio="none" aria-hidden="true"><path d="M3 10C55 2 145 2 197 8" /></svg></em>}</>
              ))}
            </span>
          ))}
        </h1>

        <p class="hero-description" style="--i:4">{siteConfig.hero.description}</p>

        <div class="hero-actions" style="--i:5">
          <a class="btn btn-primary" href={siteConfig.hero.primaryCta.href}>
            {siteConfig.hero.primaryCta.label}<Icon name="arrow-right" size={16} />
          </a>
          <a class="btn btn-outline" href={siteConfig.hero.secondaryCta.href}>
            {siteConfig.hero.secondaryCta.label}<Icon name="arrow-up-right" size={15} />
          </a>
        </div>

        <div class="hero-scroll" style="--i:6" aria-hidden="true">
          <span class="scroll-mouse"><i></i></span>
          <span>向下探索</span>
        </div>
      </div>

      <div class="hero-visual" data-parallax data-tilt data-tilt-max={3} style="--i:4">
        <div class="orbit orbit-outer"></div>
        <div class="orbit orbit-inner"></div>
        <div class="visual-main">
          <div class="visual-cover">
            <img src={featured?.data.cover} alt="" width="560" height="360" />
            <span class="visual-badge"><Icon name="sparkles" size={13} /> 精选</span>
          </div>
          <div class="visual-text">
            <span class="visual-kicker">LATEST ESSAY · {featured?.data.category}</span>
            <h2>{featured?.data.title}</h2>
            <p>{featured?.data.description}</p>
            <a href={`/writing/${featured?.id}`} aria-label={`阅读 ${featured?.data.title}`}>
              阅读全文 <Icon name="arrow-right" size={15} />
            </a>
          </div>
        </div>
        <div class="float-card float-note">
          <span class="float-icon"><Icon name="sparkles" size={15} /></span>
          <div><strong>灵感碎片</strong><small>{allNotes.length} 条笔记正在生长</small></div>
        </div>
        <div class="float-card float-stat">
          <span class="float-ring"><Icon name="heart" size={17} /></span>
          <div><strong>持续记录</strong><small>Since 2019</small></div>
        </div>
        <div class="float-dot dot-a"></div>
        <div class="float-dot dot-b"></div>
      </div>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[...marqueeWords, ...marqueeWords].map((word) => (
        <span><i>✳</i>{word}</span>
      ))}
    </div>
  </div>

  <section class="section featured-section">
    <div class="container">
      <Reveal>
        <div class="section-head">
          <div>
            <span class="eyebrow">SELECTED WORKS</span>
            <h2 class="section-title">近期<em>精选</em></h2>
          </div>
          <div class="head-right">
            <p class="section-desc">一些经过时间沉淀的文字。关于设计、技术，以及那些说不清楚但值得记下来的瞬间。</p>
            <a class="link-arrow" href="/writing">全部文章 <Icon name="arrow-right" size={15} /></a>
          </div>
        </div>
      </Reveal>

      <div class="featured-grid">
        {featured && <PostCard post={featured} variant="feature" index={0} />}
        <div class="featured-side">
          {restPosts.map((post, i) => <PostCard post={post} variant="compact" index={i + 1} />)}
        </div>
      </div>
    </div>
  </section>

  <section class="section notes-section">
    <div class="container">
      <Reveal>
        <div class="section-head">
          <div>
            <span class="eyebrow">FLEETING THOUGHTS</span>
            <h2 class="section-title">随手<em>记</em></h2>
          </div>
          <a class="link-arrow" href="/notes">查看全部笔记 <Icon name="arrow-right" size={15} /></a>
        </div>
      </Reveal>
      <div class="notes-grid">
        {latestNotes.map((note, i) => <NoteCard note={note} index={i} />)}
      </div>
    </div>
  </section>

  <section class="section-tight stats-section">
    <div class="container">
      <Reveal>
        <div class="stats-intro">
          <span class="eyebrow">BY THE NUMBERS</span>
          <h2 class="section-title">时间会给出<em>答案</em></h2>
          <p>数字不是目的，但它们是这段旅程留下的痕迹。</p>
        </div>
      </Reveal>
      <Stats />
    </div>
  </section>

  <section class="section philosophy-section">
    <div class="container">
      <Reveal>
        <div class="section-head">
          <div>
            <span class="eyebrow">HOW I THINK</span>
            <h2 class="section-title">一些<em>坚持</em></h2>
          </div>
        </div>
      </Reveal>
      <div class="philosophy-grid">
        {[
          { icon: 'compass', title: '缓慢，但清晰', body: '不急着给出答案。先把问题看清楚，再决定要不要回答。好想法需要发酵的时间。' },
          { icon: 'sparkles', title: '细节里的温度', body: '一个像素的偏移、一次恰到好处的停顿——体验的质量藏在这些没人会刻意注意的地方。' },
          { icon: 'quote', title: '开放地表达', body: '把过程写下来，把失败也写下来。知识只有在流动中才会生长，博客也是如此。' },
        ].map((item, i) => (
          <div class="philosophy-card" data-reveal data-spotlight style={`--reveal-delay:${i * 100}ms`}>
            <span class="philosophy-icon"><Icon name={item.icon} size={22} /></span>
            <span class="philosophy-num">0{i + 1}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight subscribe-section">
    <div class="container"><Subscribe /></div>
  </section>
</BaseLayout>

<style>
  /* ---------------- Hero ---------------- */
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(3rem, 7vw, 6rem);
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }
  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    min-height: min(660px, 76vh);
    perspective: 1400px;
  }
  .hero-copy > * {
    opacity: 0;
    animation: rise-in 850ms var(--ease-out) forwards;
    animation-delay: calc(var(--i, 0) * 105ms);
  }
  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.95rem 0.4rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    background: var(--surface-soft);
    backdrop-filter: blur(10px);
    font-size: 0.72rem;
    font-weight: 600;
    box-shadow: var(--shadow-xs);
  }
  .status-dot {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--mint);
  }
  .status-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--mint);
    animation: pulse-ring 2.2s ease-out infinite;
  }
  .status-sep {
    width: 1px;
    height: 12px;
    background: var(--line-strong);
  }
  .status-sub {
    color: var(--muted);
    font-weight: 500;
  }
  .hero-eyebrow {
    margin-top: 2.5rem;
    color: var(--ember);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.24em;
  }
  .hero-title {
    margin-top: 1.1rem;
    font-family: var(--font-serif);
    font-size: clamp(3rem, 7.2vw, 6rem);
    font-weight: 600;
    line-height: 1.14;
    letter-spacing: -0.055em;
  }
  .hero-line {
    display: block;
    opacity: 0;
    animation: rise-in 950ms var(--ease-out) forwards;
    animation-delay: calc(var(--i) * 115ms + 120ms);
  }
  .hero-line em {
    position: relative;
    font-style: normal;
    background: linear-gradient(110deg, var(--ember), var(--indigo));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-line em svg {
    position: absolute;
    left: -2%;
    bottom: -0.16em;
    width: 104%;
    height: 0.2em;
    overflow: visible;
  }
  .hero-line em svg path {
    fill: none;
    stroke: var(--ember);
    stroke-width: 3;
    stroke-linecap: round;
    opacity: 0.55;
    stroke-dasharray: 220;
    stroke-dashoffset: 220;
    animation: draw-swoosh 1.1s var(--ease-out) forwards 900ms;
  }
  @keyframes draw-swoosh {
    to { stroke-dashoffset: 0; }
  }
  .hero-description {
    max-width: 33rem;
    margin-top: 2rem;
    color: var(--ink-soft);
    font-size: clamp(0.95rem, 1.4vw, 1.1rem);
    line-height: 2;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2.4rem;
  }
  .hero-scroll {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: clamp(3rem, 6vw, 5rem);
    color: var(--faint);
    font-size: 0.7rem;
    letter-spacing: 0.15em;
  }
  .scroll-mouse {
    display: grid;
    place-items: start center;
    width: 18px;
    height: 28px;
    padding-top: 5px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-full);
  }
  .scroll-mouse i {
    width: 3px;
    height: 6px;
    border-radius: 2px;
    background: var(--ember);
    animation: scroll-wheel 1.8s ease-in-out infinite;
  }
  @keyframes scroll-wheel {
    0%, 100% { transform: translateY(0); opacity: 1; }
    70% { transform: translateY(9px); opacity: 0.2; }
  }

  /* ---------------- Hero visual ---------------- */
  .hero-visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 460px;
    opacity: 0;
    translate: 0 var(--parallax-y, 0px);
    will-change: translate;
    animation: rise-in 1s var(--ease-out) forwards;
    animation-delay: 520ms;
  }
  .orbit {
    position: absolute;
    border: 1px dashed var(--line-strong);
    border-radius: 50%;
  }
  .orbit-outer {
    width: min(100%, 520px);
    aspect-ratio: 1;
    animation: spin-slow 70s linear infinite;
  }
  .orbit-inner {
    width: min(78%, 400px);
    aspect-ratio: 1;
    border-style: solid;
    border-color: var(--line);
    animation: spin-slow 50s linear infinite reverse;
  }
  .visual-main {
    position: relative;
    z-index: 2;
    width: min(100%, 430px);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background: var(--surface);
    box-shadow: var(--shadow-lg);
    transform: rotate(-2.5deg);
    transition: transform 700ms var(--ease-spring);
  }
  .hero-visual:hover .visual-main {
    transform: rotate(0deg) translateY(-6px);
  }
  .visual-cover {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .visual-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease-out);
  }
  .hero-visual:hover .visual-cover img {
    transform: scale(1.06);
  }
  .visual-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.9);
    color: #23211f;
    font-size: 0.68rem;
    font-weight: 700;
  }
  .visual-text {
    padding: 1.5rem 1.7rem 1.8rem;
  }
  .visual-kicker {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.15em;
    color: var(--ember);
  }
  .visual-text h2 {
    margin-top: 0.65rem;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    line-height: 1.4;
    letter-spacing: -0.02em;
  }
  .visual-text p {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-top: 0.6rem;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.75;
  }
  .visual-text a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.1rem;
    font-size: 0.78rem;
    font-weight: 650;
  }
  .visual-text a:hover {
    color: var(--ember);
  }
  .float-card {
    position: absolute;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.7rem 1rem 0.7rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface-soft);
    backdrop-filter: blur(16px);
    box-shadow: var(--shadow-md);
    animation: float-card 6s var(--ease-in-out) infinite;
  }
  .float-card strong,
  .float-card small {
    display: block;
    line-height: 1.4;
  }
  .float-card strong {
    font-size: 0.78rem;
  }
  .float-card small {
    font-size: 0.63rem;
    color: var(--muted);
  }
  .float-icon,
  .float-ring {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-sm);
    background: var(--indigo-soft);
    color: var(--indigo);
  }
  .float-note {
    left: -2%;
    top: 16%;
    animation-delay: -1s;
  }
  .float-stat {
    right: -3%;
    bottom: 13%;
    animation-delay: -3.5s;
  }
  .float-stat .float-ring {
    border-radius: 50%;
    background: var(--ember-soft);
    color: var(--ember);
  }
  @keyframes float-card {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-14px); }
  }
  .float-dot {
    position: absolute;
    z-index: 1;
    border-radius: 50%;
    background: var(--ember);
    opacity: 0.5;
  }
  .dot-a { width: 7px; height: 7px; top: 4%; right: 12%; }
  .dot-b { width: 5px; height: 5px; bottom: 8%; left: 18%; background: var(--indigo); }

  /* ---------------- Marquee ---------------- */
  .marquee {
    position: relative;
    z-index: 1;
    overflow: hidden;
    padding-block: 1.1rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--paper-deep);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .marquee-track {
    display: flex;
    width: max-content;
    gap: 3.5rem;
    animation: marquee 38s linear infinite;
  }
  .marquee-track span {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    color: var(--muted);
    white-space: nowrap;
  }
  .marquee-track i {
    color: var(--ember);
    font-size: 0.8rem;
    font-style: normal;
  }
  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  /* ---------------- Featured ---------------- */
  .head-right {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  .featured-grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 1.4rem;
    perspective: 1300px;
  }
  .featured-side {
    display: grid;
    grid-template-rows: repeat(3, 1fr);
    gap: 1.1rem;
  }
  .featured-side :global(.post-card.compact) {
    border-radius: var(--radius-md);
  }

  /* ---------------- Notes ---------------- */
  .notes-section {
    background: var(--paper-deep);
    border-block: 1px solid var(--line);
  }
  .notes-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.3rem;
    perspective: 1300px;
  }

  /* ---------------- Stats ---------------- */
  .stats-section {
    position: relative;
  }
  .stats-intro {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  .stats-intro p {
    margin-top: 1rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  /* ---------------- Philosophy ---------------- */
  .philosophy-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }
  .philosophy-card {
    position: relative;
    padding: 2.2rem 1.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
    transition: transform var(--t-base) var(--ease-out), box-shadow var(--t-base);
  }
  .philosophy-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
  }
  .philosophy-icon {
    display: grid;
    place-items: center;
    width: 2.8rem;
    height: 2.8rem;
    border-radius: var(--radius-sm);
    background: var(--ember-soft);
    color: var(--ember);
  }
  .philosophy-num {
    position: absolute;
    top: 1.3rem;
    right: 1.6rem;
    font-family: var(--font-mono);
    font-size: 2.4rem;
    font-weight: 700;
    color: var(--line);
  }
  .philosophy-card h3 {
    margin-top: 1.7rem;
    font-family: var(--font-serif);
    font-size: 1.3rem;
  }
  .philosophy-card p {
    margin-top: 0.8rem;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.9;
  }

  @media (max-width: 1020px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .hero-visual {
      min-height: 420px;
    }
    .hero-copy {
      order: 1;
    }
    .hero-scroll {
      display: none;
    }
    .featured-grid {
      grid-template-columns: 1fr;
    }
    .featured-side {
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: auto;
    }
  }
  @media (max-width: 720px) {
    .notes-grid,
    .philosophy-grid,
    .featured-side {
      grid-template-columns: 1fr;
    }
    .float-note { left: 0; }
    .float-stat { right: 0; }
    .visual-main { width: 100%; }
    .hero-title { font-size: clamp(2.7rem, 11vw, 4rem); }
    .status-sub, .status-sep { display: none; }
  }
</style>
