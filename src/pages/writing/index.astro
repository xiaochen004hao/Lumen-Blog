---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import PostCard from '../../components/PostCard.astro';
import Aurora from '../../components/Aurora.astro';
import { siteConfig } from '../../data/site.config';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const tags = Array.from(new Set(posts.flatMap((post) => post.data.tags))).sort((a, b) => a.localeCompare(b, 'zh-CN'));
---

<BaseLayout title="文章" description={`${siteConfig.title} 的全部文章 —— 关于设计、代码与缓慢思考的长文。`}>
  <section class="page-hero">
    <Aurora />
    <div class="container page-hero-inner">
      <div class="page-eyebrow"><span></span>THE ARCHIVE</div>
      <h1 transition:name="page-heading">所有<em>文章</em></h1>
      <p>一篇篇写下来的思考。按标签筛选，或者用 <kbd>⌘ K</kbd> 搜索你感兴趣的内容。</p>
      <div class="hero-count"><Icon name="hash" size={14} /> 共 {posts.length} 篇 · {tags.length} 个标签</div>
    </div>
  </section>

  <section class="section-tight archive-section">
    <div class="container">
      <div class="toolbar">
        <div class="filters" role="group" aria-label="按标签筛选">
          <button class="filter-pill is-active" type="button" data-filter="all" data-reveal="pop" style="--reveal-delay:0ms">全部 <span>{posts.length}</span></button>
          {tags.map((tag, ti) => (
            <button class="filter-pill" type="button" data-filter={tag} data-reveal="pop" style={`--reveal-delay:${(ti + 1) * 45}ms`}>
              #{tag} <span>{posts.filter((p) => p.data.tags.includes(tag)).length}</span>
            </button>
          ))}
        </div>
        <div class="toolbar-right">
          <button class="search-inline" type="button" data-search-open>
            <Icon name="search" size={14} /> 搜索文章
          </button>
          <div class="view-toggle" role="group" aria-label="切换视图">
            <button type="button" data-view-toggle="grid" class="is-active" aria-label="网格视图"><Icon name="grid" size={15} /></button>
            <button type="button" data-view-toggle="list" aria-label="列表视图"><Icon name="list" size={15} /></button>
          </div>
        </div>
      </div>

      <div class="archive-grid" data-post-grid data-view="grid">
        {posts.map((post, i) => (
          <div class="grid-cell" data-post-card data-tags={post.data.tags.join('|')}>
            <PostCard post={post} index={i} />
          </div>
        ))}
      </div>
      <p class="empty-state">这个标签下暂时没有文章，换个标签试试？</p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 9vw, 7rem) clamp(3rem, 6vw, 4.5rem);
    border-bottom: 1px solid var(--line);
  }
  .page-hero-inner {
    position: relative;
    z-index: 1;
  }
  .page-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--ember);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.22em;
  }
  .page-eyebrow span {
    width: 1.6rem;
    height: 1px;
    background: currentColor;
  }
  h1 {
    margin-top: 1.2rem;
    font-family: var(--font-serif);
    font-size: clamp(2.8rem, 7vw, 5.2rem);
    font-weight: 600;
    letter-spacing: -0.05em;
  }
  h1 em {
    font-style: normal;
    color: var(--ember);
  }
  .page-hero p {
    max-width: 36rem;
    margin-top: 1.3rem;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.9;
  }
  kbd {
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }
  .hero-count {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.8rem;
    color: var(--faint);
    font-size: 0.76rem;
    font-family: var(--font-mono);
  }

  .toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2.2rem;
    padding-bottom: 1.4rem;
    border-bottom: 1px solid var(--line);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .filter-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    background: var(--surface);
    color: var(--muted);
    font-size: 0.78rem;
    transition: all var(--t-fast) var(--ease-out);
  }
  .filter-pill span {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    opacity: 0.7;
  }
  .filter-pill:hover {
    color: var(--ink);
    border-color: var(--line-strong);
    transform: translateY(-1px);
  }
  .filter-pill.is-active {
    color: var(--paper);
    background: var(--ink);
    border-color: var(--ink);
  }
  .toolbar-right {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .search-inline {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--muted);
    font-size: 0.78rem;
  }
  .search-inline:hover {
    color: var(--ember);
    border-color: var(--ember);
  }
  .view-toggle {
    display: flex;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    background: var(--surface);
  }
  .view-toggle button {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
  }
  .view-toggle button.is-active {
    background: var(--ink);
    color: var(--paper);
  }

  .archive-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.4rem;
    transition: gap var(--t-base);
  }
  .grid-cell {
    min-width: 0;
    perspective: 1100px;
    transition: opacity 300ms var(--ease-out), transform 300ms var(--ease-out);
  }
  .grid-cell.is-filtered-out {
    display: none;
  }
  .archive-grid[data-view='list'] {
    grid-template-columns: 1fr;
    gap: 0.9rem;
  }
  .archive-grid[data-view='list'] :global(.post-card) {
    border-radius: var(--radius-md);
  }
  .archive-grid[data-view='list'] :global(.card-link) {
    flex-direction: row;
    align-items: stretch;
  }
  .archive-grid[data-view='list'] :global(.cover) {
    width: 220px;
    aspect-ratio: auto;
    flex: none;
  }
  .archive-grid[data-view='list'] :global(.body) {
    justify-content: center;
    padding-block: 1.2rem;
  }
  .archive-grid[data-view='list'] :global(.card-foot) {
    margin-top: 0.8rem;
    padding-top: 0.8rem;
  }
  .empty-state {
    display: none;
    padding: 4rem 1rem;
    text-align: center;
    color: var(--muted);
  }

  @media (max-width: 980px) {
    .archive-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .archive-grid,
    .archive-grid[data-view='list'] {
      grid-template-columns: 1fr;
    }
    .archive-grid[data-view='list'] :global(.cover) {
      width: 110px;
    }
    .toolbar {
      align-items: flex-start;
    }
  }
</style>
